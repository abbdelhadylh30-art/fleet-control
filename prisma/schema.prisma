// Fleet Control — Prisma schema (PostgreSQL / Neon as of v18)
// The single PgState table holds every runtime state blob (security events,
// activity, uptime, score history, incidents, IndexNow log, auto-pilot,
// agent sessions, postgres-audit baseline + per-app migration progress) as
// JSON documents — see src/lib/pg-state.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection (runtime)
  directUrl = env("DIRECT_URL")        // direct connection (schema push)
}

model PgState {
  key       String   @id
  value     Json
  version   Int      @default(0) // optimistic-concurrency guard for mutateState CAS writes
  updatedAt DateTime @updatedAt
}
